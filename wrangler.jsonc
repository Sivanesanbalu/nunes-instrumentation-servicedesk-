{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nunes-instrumentation-servicedesk-staging",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-16",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "workers_dev": false,
  "preview_urls": false
}
